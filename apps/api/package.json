{
  "name": "@bus/api",
  "version": "1.0.0",
  "description": "Backend API for Ethiopian Intercity Bus Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:express": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/main.ts",
    "start:express": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx src/db/seed.ts",
    "test:concurrency": "tsx src/test/concurrency.test.ts",
    "test:engine": "tsx src/modules/trips/trips-inventory-engine.spec.ts",
    "test:agent": "tsx src/modules/agent/agent-terminal-system.spec.ts",
    "test:e2e:booking": "tsx src/test/first-production-e2e-booking.spec.ts",
    "test:phase1": "tsx src/test/phase1-foundation-lifecycle.spec.ts"
  },
  "dependencies": {
    "@bus/shared": "file:../../packages/shared",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
